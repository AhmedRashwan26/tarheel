# Server Environment
PORT=3000
NODE_ENV=development

# Database URL (PostgreSQL)
DATABASE_URL="postgresql://tarheel:tarheel_secret@localhost:5432/tarheel_db?schema=public"

# JWT Secret Configuration
JWT_SECRET="tarheel_super_secure_jwt_secret_key_2026_production_grade"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="tarheel_refresh_token_secret_key_2026_production"
JWT_REFRESH_EXPIRES_IN="30d"

# Platform Financial Configuration
PLATFORM_COMMISSION_PERCENTAGE=10

# Uploads Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# Redis Configuration (Optional for clustering / Queue)
REDIS_HOST="localhost"
REDIS_PORT=6379
