# Server Environment
PORT=3000
NODE_ENV=development

# Database URL (PostgreSQL)
DATABASE_URL="postgresql://tarheel:tarheel_secret@localhost:5432/tarheel_db?schema=public"

# JWT Secret Configuration
JWT_SECRET="tarheel_super_secure_jwt_secret_key_2026_production_grade"
JWT_EXPIRES_IN="7d"

# Financial Configuration
PLATFORM_COMMISSION_PERCENTAGE=10
VAT_PERCENTAGE=15

# Uploads Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=25

# ========================================================
# 📧 إعدادات إرسال الإيميل (Email OTP & Notifications)
# ========================================================
# اسم وعنوان الإيميل المرسل (مثل: auth@tarheel.app أو no-reply@tarheel.sa)
EMAIL_FROM="no-reply@tarheel.app"
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="resend"
SMTP_PASS="re_your_api_key_here"

# ========================================================
# 💬 إعدادات إرسال الواتساب (WhatsApp OTP - Meta Cloud API)
# ========================================================
# خادم الواتساب المفتوح المصدر المجاني المستضاف ذاتياً (Self-Hosted Baileys Gateway)
WHATSAPP_GATEWAY_URL="http://whatsapp:3001"
WHATSAPP_API_URL="https://graph.facebook.com/v21.0"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_API_TOKEN="your_meta_system_user_access_token"

# ========================================================
# 📱 إعدادات الرسائل النصية (SMS Gateway - Taqnyat / Unifonic)
# ========================================================
TAQNYAT_API_KEY=""
SMS_SENDER_NAME="Tarheel"

# Redis Configuration (Optional)
REDIS_HOST="localhost"
REDIS_PORT=6379
