# ==============================================================================
# Tarheel Platform - Flutter Web Production Container (Pre-built Web Release)
# ==============================================================================

FROM nginx:alpine

# Copy pre-compiled Flutter Web Release Bundle
COPY tarheel_app/build/web /usr/share/nginx/html

# Copy optimized Nginx configuration
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
